function handleWorkTogether(id, caption){
  if(state.workTogether.includes(id)){ toast('Already working together'); return; }
  const p = findProfileById(id);
  if(!p) return;
  state.workTogether.push(id);
  const myCategory = state.profile ? state.profile.subroleLabel : 'creator';
  const introText = `Hello, I am ${myCategory}${caption ? ' and I want to work with you on this: "'+caption+'"' : ' and I would love to work together!'}`;
  if(!state.chats[id]) state.chats[id] = [];
  state.chats[id].push({ from:'me', text: introText });
  saveState();
  render();
  toast(`Request sent to ${p.penName}`);
  setTimeout(()=>{
    if(!state.chats[id]) return;
    const replies = [
      "Hey! Thanks for reaching out — let's talk details.",
      "Love the energy, send me what you've got so far.",
      "I'm in. Can't pay upfront though, maybe we do a 50-50 on this one?",
      "Sounds good, drop your reference track and I'll get back to you."
    ];
    state.chats[id].push({ from:'them', text: replies[Math.floor(Math.random()*replies.length)] });
    saveState();
    if(state.mainTab==='messages' && state.activeChatId===id) render();
  }, 1600);
}

function sendChatMessage(){
  const inp = frame.querySelector('#chat-input');
  if(!inp) return;
  const text = inp.value.trim();
  if(!text) return;
  const id = state.activeChatId;
  if(!state.chats[id]) state.chats[id] = [];
  state.chats[id].push({ from:'me', text });
  saveState();
  render();
  const body = frame.querySelector('#chat-body');
  if(body) body.scrollTop = body.scrollHeight;
}

function submitProfile(){
  formErrors = {};
  if(!draftProfile.name.trim()) formErrors.name = true;
  if(!draftProfile.subrole) formErrors.subrole = true;
  if(Object.keys(formErrors).length){ render(); return; }

  const subLabels = (state.onboardRole==='designer') ? DESIGNER_CATS : WRITER_CATS;
  const subroleLabel = draftProfile.subrole==='d' ? (draftProfile.subroleOther || 'Other') : subLabels[draftProfile.subrole];

  const profile = {
    photo: draftProfile.photo,
    name: draftProfile.name.trim(),
    penName: draftProfile.penName.trim() || draftProfile.name.trim(),
    role: state.onboardRole,
    subroleLabel,
    handle: draftProfile.handle.trim(),
    workNote: draftProfile.workNote.trim(),
    bio: draftProfile.bio.trim(), // private — manager-only in a real deployment
    worksCount: draftProfile.workNote.trim() ? 1 : 0,
  };
  setState({ profile, screen:'deal', dealOverlay:false });
}

