@keyframes riseIn{ from{ opacity:0; translate:0 24px; scale:.97; } }
@keyframes logoIn{ from{ opacity:0; translate:-14px 0; } }
@keyframes icPop{ 0%{ scale:.4; rotate:-20deg; } 100%{ scale:1; rotate:0deg; } }
@keyframes shine{ to{ background-position:-220% 0; } }
@keyframes gradShift{ 0%,100%{ background-position:0 50%; } 50%{ background-position:100% 50%; } }
@keyframes bubbleIn{ from{ opacity:0; translate:0 10px; scale:.92; } }
@keyframes fadeIn{ from{ opacity:0; } }
@keyframes popIn{ from{ opacity:0; transform:translateY(24px) scale(.96); } }
@keyframes eq{
  0%{ background-size:6px 30%,6px 85%,6px 50%,6px 95%,6px 40%,6px 75%,6px 35%,6px 60%; }
  50%{ background-size:6px 80%,6px 35%,6px 90%,6px 45%,6px 85%,6px 30%,6px 70%,6px 40%; }
  100%{ background-size:6px 45%,6px 70%,6px 30%,6px 80%,6px 60%,6px 95%,6px 55%,6px 85%; }
}
@media (prefers-reduced-motion: reduce){
  .view-enter .content > *,.view-enter .topbar .logo,.view-enter .bottom-nav button.active .ic,
  .topbar .logo span,.onb-logo,.training-cta,.beat-cta,.bottom-nav::before,.bottom-nav::after,
  .chat-body .bubble:last-child,.deal-overlay,.deal-sheet{ animation:none !important; }
}
