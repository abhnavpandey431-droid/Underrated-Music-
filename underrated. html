<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
<title>UNDERRATED MUSIC</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#12100E;
  --panel:#1B1714;
  --panel-2:#221D19;
  --line:#332C26;
  --text:#F3EFE8;
  --muted:#A69C8E;
  --gold:#E8A33D;
  --violet:#8C7CFF;
  --pink:#FF6FA5;
  --green:#5FBF8F;
  --radius:16px;
  --radius-sm:10px;
}
:root:not([data-theme="light"]){ }
@media (prefers-color-scheme: light){
  :root:not([data-theme="dark"]){
    --bg:#F6F2EC; --panel:#FFFFFF; --panel-2:#F0EAE1; --line:#E3DACB; --text:#20180F; --muted:#7A6F5E;
  }
}
:root[data-theme="light"]{
  --bg:#F6F2EC; --panel:#FFFFFF; --panel-2:#F0EAE1; --line:#E3DACB; --text:#20180F; --muted:#7A6F5E;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',system-ui,-apple-system,sans-serif;
  min-height:100vh;
  display:flex;
  justify-content:center;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,h4,.display{font-family:'Space Grotesk',system-ui,sans-serif;}
button{font-family:inherit;}
img{max-width:100%;}
a{color:inherit;}
::-webkit-scrollbar{width:0;height:0;}

.frame{
  width:100%;
  max-width:430px;
  min-height:100vh;
  background:var(--panel);
  position:relative;
  display:flex;
  flex-direction:column;
  overflow-x:hidden;
  border-left:1px solid var(--line);
  border-right:1px solid var(--line);
}
@media (min-width:431px){
  body{ padding:24px 0; }
  .frame{ min-height:844px; border-radius:28px; box-shadow:0 30px 80px rgba(0,0,0,.35); overflow:hidden; }
}

/* ---------- shared bits ---------- */
.screen{ flex:1; display:flex; flex-direction:column; min-height:100%; }
.pad{ padding:20px; }
.muted{ color:var(--muted); }
.btn{
  border:none; border-radius:999px; padding:14px 20px; font-weight:600; font-size:15px;
  cursor:pointer; transition:transform .12s ease, opacity .15s ease; font-family:'Inter',sans-serif;
}
.btn:active{ transform:scale(.97); }
.btn-primary{ background:var(--gold); color:#1B1409; }
.btn-outline{ background:transparent; color:var(--text); border:1.5px solid var(--line); }
.btn-block{ width:100%; }
.field{ margin-bottom:14px; }
.field label{ display:block; font-size:12px; color:var(--muted); margin-bottom:6px; letter-spacing:.02em; }
.field input, .field textarea, .field select{
  width:100%; background:var(--panel-2); border:1.5px solid var(--line); color:var(--text);
  border-radius:var(--radius-sm); padding:12px 14px; font-size:15px; font-family:inherit; resize:vertical;
}
.field input:focus, .field textarea:focus, .field select:focus{ outline:none; border-color:var(--gold); }
.field.error input, .field.error textarea{ border-color:var(--pink); }
.field .err-msg{ color:var(--pink); font-size:12px; margin-top:4px; display:none; }
.field.error .err-msg{ display:block; }
.pill-row{ display:flex; flex-wrap:wrap; gap:8px; }
.pill{
  border:1.5px solid var(--line); border-radius:999px; padding:9px 14px; font-size:13.5px; cursor:pointer;
  background:var(--panel-2); color:var(--text); transition:.15s;
}
.pill.selected{ background:var(--gold); border-color:var(--gold); color:#1B1409; font-weight:600; }
.upload-box{
  border:1.5px dashed var(--line); border-radius:var(--radius); padding:18px; text-align:center;
  cursor:pointer; background:var(--panel-2);
}
.upload-box:hover{ border-color:var(--gold); }
.avatar{
  width:56px; height:56px; border-radius:50%; object-fit:cover; background:var(--panel-2);
  display:flex; align-items:center; justify-content:center; font-size:22px; flex-shrink:0;
}
.avatar-sm{ width:38px; height:38px; font-size:16px; }
.tag-writer{ color:var(--gold); }
.tag-designer{ color:var(--violet); }
.tag-both{ color:var(--green); }

/* ---------- onboarding ---------- */
.onb-hero{
  flex:1; display:flex; flex-direction:column; justify-content:center; padding:36px 26px;
  background:linear-gradient(160deg,var(--bg) 0%, var(--panel) 55%);
}
.onb-logo{ font-size:13px; letter-spacing:.16em; color:var(--gold); font-weight:600; margin-bottom:6px; }
.onb-title{ font-size:34px; line-height:1.08; font-weight:700; margin:0 0 6px; }
.onb-sub{ color:var(--muted); font-size:15px; margin:0 0 30px; max-width:320px; }
.who-q{ font-size:22px; font-weight:700; margin-bottom:16px; }
.who-opt{
  display:flex; align-items:center; gap:14px; padding:16px; border-radius:var(--radius);
  border:1.5px solid var(--line); background:var(--panel-2); margin-bottom:12px; cursor:pointer;
  transition:.15s;
}
.who-opt:hover{ border-color:var(--gold); }
.who-opt .ico{ width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
.who-opt .body b{ display:block; font-size:15.5px; }
.who-opt .body span{ font-size:12.5px; color:var(--muted); }

/* ---------- deal overlay ---------- */
.deal-overlay{
  position:fixed; inset:0; background:rgba(0,0,0,.55); display:flex; align-items:flex-end;
  justify-content:center; z-index:80;
}
.deal-sheet{
  width:100%; max-width:430px; background:var(--panel); border-radius:22px 22px 0 0;
  padding:26px 22px 30px; max-height:82vh; overflow-y:auto;
  animation:slideUp .32s cubic-bezier(.16,1,.3,1);
}
@keyframes slideUp{ from{ transform:translateY(100%); } to{ transform:translateY(0); } }
.deal-badge{
  display:inline-flex; align-items:center; gap:6px; background:rgba(255,111,165,.14); color:var(--pink);
  border-radius:999px; padding:6px 12px; font-size:12px; font-weight:700; margin-bottom:14px;
}
.deal-sheet h2{ font-size:22px; margin:0 0 12px; }
.deal-sheet p{ font-size:14.5px; line-height:1.6; color:var(--muted); margin:0 0 12px; }
.deal-sheet .close-x{
  position:sticky; top:0; float:right; background:var(--panel-2); border:none; color:var(--text);
  width:32px; height:32px; border-radius:50%; font-size:16px; cursor:pointer;
}

/* ---------- header / nav ---------- */
.topbar{
  display:flex; align-items:center; justify-content:space-between; padding:16px 18px 12px;
  border-bottom:1px solid var(--line); position:sticky; top:0; background:var(--panel); z-index:10;
}
.topbar .logo{ font-weight:700; font-size:17px; letter-spacing:.01em; }
.topbar .logo span{ color:var(--gold); }
.icon-btn{
  background:var(--panel-2); border:1px solid var(--line); width:36px; height:36px; border-radius:50%;
  display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:16px; color:var(--text);
  position:relative;
}
.dot-badge::after{
  content:''; position:absolute; top:5px; right:6px; width:7px; height:7px; border-radius:50%;
  background:var(--pink); border:1.5px solid var(--panel);
}

.bottom-nav{
  display:flex; border-top:1px solid var(--line); background:var(--panel); position:sticky; bottom:0; z-index:10;
}
.bottom-nav button{
  flex:1; background:none; border:none; padding:10px 0 12px; display:flex; flex-direction:column;
  align-items:center; gap:3px; color:var(--muted); cursor:pointer; font-size:10.5px; font-weight:600;
}
.bottom-nav button .ic{ font-size:19px; }
.bottom-nav button.active{ color:var(--gold); }

.content{ flex:1; overflow-y:auto; padding-bottom:6px; }

/* ---------- feed ---------- */
.section-title{ font-size:13px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); padding:16px 18px 8px; font-weight:700; }
.card{ border-bottom:1px solid var(--line); padding:14px 18px; }
.card-head{ display:flex; align-items:center; gap:10px; margin-bottom:10px; }
.card-head .names{ flex:1; min-width:0; }
.card-head .names b{ font-size:14.5px; display:block; }
.card-head .names .cat{ font-size:12px; color:var(--muted); }
.work-btn{
  border:1.5px solid var(--gold); color:var(--gold); background:transparent; border-radius:999px;
  padding:7px 14px; font-size:12.5px; font-weight:700; cursor:pointer; flex-shrink:0; white-space:nowrap;
}
.work-btn.active{ background:var(--gold); color:#1B1409; }
.msg-ic{ background:var(--panel-2); border:1px solid var(--line); border-radius:50%; width:32px; height:32px; display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; }
.media-box{
  border-radius:var(--radius); overflow:hidden; background:var(--panel-2); min-height:180px;
  display:flex; align-items:center; justify-content:center; font-size:38px; position:relative; margin-bottom:10px;
}
.media-caption{ font-size:13.5px; line-height:1.5; }
.media-caption b{ font-weight:600; }

.suggest-row{ display:flex; align-items:center; gap:12px; padding:12px 18px; border-bottom:1px solid var(--line); }
.suggest-row .names{ flex:1; }
.suggest-row .names b{ font-size:14px; display:block; }
.suggest-row .names .cat{ font-size:12px; color:var(--muted); }

/* ---------- learn ---------- */
.training-cta{
  margin:14px 18px; border-radius:999px; background:linear-gradient(90deg,var(--violet),var(--pink));
  color:#fff; text-align:center; padding:14px; font-weight:700; cursor:pointer; font-size:14.5px;
}
.lesson-card{ display:flex; gap:12px; padding:12px 18px; border-bottom:1px solid var(--line); cursor:pointer; }
.lesson-thumb{ width:88px; height:64px; border-radius:10px; flex-shrink:0; background:var(--panel-2); display:flex; align-items:center; justify-content:center; font-size:22px; }
.lesson-info b{ font-size:14px; display:block; margin-bottom:3px; }
.lesson-info span{ font-size:12px; color:var(--muted); }
.lock-chip{ font-size:10.5px; background:var(--panel-2); border:1px solid var(--line); border-radius:6px; padding:2px 6px; margin-top:5px; display:inline-block; }
.lock-chip.free{ color:var(--green); border-color:var(--green); }
.lock-chip.premium{ color:var(--gold); border-color:var(--gold); }

.beat-row{ display:flex; align-items:center; gap:12px; padding:12px 18px; border-bottom:1px solid var(--line); }
.beat-wave{ width:40px; height:40px; border-radius:10px; background:var(--panel-2); display:flex; align-items:center; justify-content:center; font-size:17px; flex-shrink:0; }
.beat-info{ flex:1; min-width:0; }
.beat-info b{ font-size:13.5px; display:block; }
.beat-info span{ font-size:11.5px; color:var(--muted); }
.status-chip{ font-size:10.5px; border-radius:6px; padding:3px 8px; font-weight:700; flex-shrink:0; }
.status-chip.approved{ background:rgba(95,191,143,.15); color:var(--green); }
.status-chip.pending{ background:rgba(232,163,61,.15); color:var(--gold); }
.status-chip.rejected{ background:rgba(255,111,165,.15); color:var(--pink); }

/* ---------- creation zone (reels-like) ---------- */
.reel-card{ border-bottom:8px solid var(--bg); padding:0 0 14px; }
.reel-media{ height:280px; background:var(--panel-2); display:flex; align-items:center; justify-content:center; font-size:44px; position:relative; }
.reel-body{ padding:12px 18px 0; }
.reel-actions{ display:flex; gap:10px; margin-top:10px; }
.reel-actions button{ flex:1; }
.comment-block{ padding:10px 18px 0; }
.comment-line{ font-size:13px; margin-bottom:8px; line-height:1.5; }
.comment-line b{ font-weight:600; margin-right:4px; }
.deal-link{ color:var(--pink); font-weight:700; cursor:pointer; text-decoration:underline; }
.comment-input-row{ display:flex; gap:8px; padding:10px 18px 16px; }
.comment-input-row input{ flex:1; background:var(--panel-2); border:1.5px solid var(--line); border-radius:999px; padding:10px 14px; color:var(--text); font-size:13.5px; }
.comment-input-row button{ background:var(--gold); border:none; border-radius:999px; padding:0 16px; font-weight:700; color:#1B1409; }

/* ---------- me page ---------- */
.me-header{ padding:22px 18px; display:flex; gap:16px; align-items:center; border-bottom:1px solid var(--line); }
.me-header .avatar{ width:74px; height:74px; font-size:28px; }
.me-name{ font-size:19px; font-weight:700; margin:0; }
.me-cat{ font-size:13px; color:var(--muted); margin:2px 0 8px; }
.me-cat.tag-writer{ color:var(--gold); font-weight:600; }
.me-cat.tag-designer{ color:var(--violet); font-weight:600; }
.me-cat.tag-both{ color:var(--green); font-weight:600; }
.me-stats{ display:flex; gap:18px; padding:16px 18px; border-bottom:1px solid var(--line); }
.me-stat b{ font-size:18px; display:block; }
.me-stat span{ font-size:11.5px; color:var(--muted); }
.me-section{ padding:16px 18px; border-bottom:1px solid var(--line); }
.me-section h4{ font-size:12.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin:0 0 10px; }
.info-row{ display:flex; justify-content:space-between; font-size:13.5px; padding:6px 0; border-bottom:1px solid var(--line); }
.info-row:last-child{ border-bottom:none; }
.info-row span:first-child{ color:var(--muted); }
.work-grid{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px; }
.work-cell{ aspect-ratio:1; background:var(--panel-2); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:20px; }
.admin-toggle{ display:flex; align-items:center; justify-content:space-between; padding:10px 0; font-size:13px; }
.switch{ width:40px; height:22px; border-radius:999px; background:var(--line); position:relative; cursor:pointer; flex-shrink:0; }
.switch.on{ background:var(--gold); }
.switch .knob{ width:18px; height:18px; border-radius:50%; background:#fff; position:absolute; top:2px; left:2px; transition:.15s; }
.switch.on .knob{ left:20px; }
.reset-link{ color:var(--pink); font-size:12.5px; text-align:center; padding:18px; cursor:pointer; }

/* ---------- messages ---------- */
.chat-row{ display:flex; align-items:center; gap:12px; padding:12px 18px; border-bottom:1px solid var(--line); cursor:pointer; }
.chat-row .names{ flex:1; min-width:0; }
.chat-row .names b{ font-size:14px; display:block; }
.chat-row .names .last{ font-size:12.5px; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.chat-time{ font-size:11px; color:var(--muted); flex-shrink:0; }

.chat-screen{ display:flex; flex-direction:column; height:100%; }
.chat-header{ display:flex; align-items:center; gap:10px; padding:14px 16px; border-bottom:1px solid var(--line); }
.chat-header b{ font-size:15px; }
.chat-body{ flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:10px; }
.bubble{ max-width:78%; padding:10px 14px; border-radius:16px; font-size:13.5px; line-height:1.4; }
.bubble.me{ align-self:flex-end; background:var(--gold); color:#1B1409; border-bottom-right-radius:4px; }
.bubble.them{ align-self:flex-start; background:var(--panel-2); border-bottom-left-radius:4px; }
.chat-input-row{ display:flex; gap:8px; padding:12px 16px; border-top:1px solid var(--line); }
.chat-input-row input{ flex:1; background:var(--panel-2); border:1.5px solid var(--line); border-radius:999px; padding:11px 15px; color:var(--text); font-size:14px; }
.chat-input-row button{ background:var(--gold); border:none; border-radius:50%; width:40px; height:40px; font-size:16px; color:#1B1409; cursor:pointer; }

.empty{ padding:50px 24px; text-align:center; color:var(--muted); font-size:13.5px; }
.back-row{ display:flex; align-items:center; gap:10px; padding:16px 18px 4px; }
.back-btn{ background:var(--panel-2); border:1px solid var(--line); border-radius:50%; width:34px; height:34px; display:flex; align-items:center; justify-content:center; cursor:pointer; }

.toast{
  position:fixed; bottom:90px; left:50%; transform:translateX(-50%); background:var(--panel-2);
  border:1px solid var(--line); color:var(--text); padding:11px 18px; border-radius:999px; font-size:13px;
  z-index:90; box-shadow:0 8px 24px rgba(0,0,0,.3); opacity:0; transition:opacity .25s;
}
.toast.show{ opacity:1; }

/* ===== Premium 3D layer (additive, visual only) ===== */
.frame{ isolation:isolate; }
.frame::before,.frame::after{
  content:""; position:absolute; z-index:-1; pointer-events:none; border-radius:50%; filter:blur(60px); opacity:.35;
}
.frame::before{ width:260px; height:260px; top:-60px; right:-70px; background:var(--gold); animation:orbA 14s ease-in-out infinite alternate; }
.frame::after{ width:240px; height:240px; bottom:-70px; left:-80px; background:var(--violet); animation:orbB 17s ease-in-out infinite alternate; }
@keyframes orbA{ to{ transform:translate3d(-50px,90px,0) scale(1.15); } }
@keyframes orbB{ to{ transform:translate3d(60px,-100px,0) scale(1.2); } }
.screen{ position:relative; z-index:1; }

.who-opt,.card,.lesson-card,.reel-card{
  position:relative; overflow:hidden; will-change:transform;
  transform:perspective(700px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));
  transition:transform .2s ease-out, box-shadow .25s ease, border-color .15s;
}
.who-opt:hover,.card:hover,.lesson-card:hover,.reel-card:hover{ box-shadow:0 14px 34px rgba(0,0,0,.28), 0 0 0 1px rgba(232,163,61,.25); }
.who-opt::after,.card::after,.lesson-card::after,.reel-card::after{
  content:""; position:absolute; inset:0; pointer-events:none; opacity:0; transition:opacity .2s;
  background:radial-gradient(circle at var(--mx,50%) var(--my,50%), rgba(255,255,255,.14), transparent 55%);
}
.who-opt:hover::after,.card:hover::after,.lesson-card:hover::after,.reel-card:hover::after,
.who-opt.is-tilt::after,.card.is-tilt::after,.lesson-card.is-tilt::after,.reel-card.is-tilt::after{ opacity:1; }

.btn-primary{ box-shadow:0 6px 0 #b97a1f, 0 12px 24px rgba(232,163,61,.28); transition:transform .12s ease, box-shadow .12s ease; }
.btn-primary:active{ transform:translateY(4px) scale(.98); box-shadow:0 2px 0 #b97a1f, 0 4px 10px rgba(232,163,61,.2); }

/* one hero moment: floating 3D vinyl + flip-in role cards */
.onb-hero{ position:relative; overflow:hidden; }
.onb-hero > *:not(.vinyl){ position:relative; z-index:1; }
.vinyl{
  position:absolute; z-index:0; top:34px; right:-46px; width:170px; height:170px; border-radius:50%; pointer-events:none; opacity:.9;
  background:
    radial-gradient(circle, var(--gold) 0 13%, #1B1409 14% 17%, transparent 18%),
    repeating-radial-gradient(circle, #1d1916 0 2px, #2b241f 3px 4px),
    conic-gradient(from 0deg, rgba(255,255,255,.14), transparent 25%, rgba(255,255,255,.1) 50%, transparent 75%, rgba(255,255,255,.14));
  box-shadow:0 24px 40px rgba(0,0,0,.45);
  animation:vinylSpin 9s linear infinite, vinylFloat 6s ease-in-out infinite alternate;
}
@keyframes vinylSpin{ from{ transform:perspective(600px) rotateX(58deg) rotateZ(0deg);} to{ transform:perspective(600px) rotateX(58deg) rotateZ(360deg);} }
@keyframes vinylFloat{ from{ translate:0 0; } to{ translate:-10px 16px; } }
.onb-hero .who-opt{ animation:flipIn .7s cubic-bezier(.16,1,.3,1) both; }
.onb-hero .who-opt:nth-of-type(1){ animation-delay:.15s; }
.onb-hero .who-opt:nth-of-type(2){ animation-delay:.28s; }
.onb-hero .who-opt:nth-of-type(3){ animation-delay:.41s; }
@keyframes flipIn{ from{ opacity:0; transform:perspective(700px) rotateX(-60deg) translateY(30px); } to{ opacity:1; transform:perspective(700px) rotateX(0) translateY(0); } }

@media (prefers-reduced-motion: reduce){
  .frame::before,.frame::after,.vinyl,.onb-hero .who-opt{ animation:none !important; }
  .who-opt,.card,.lesson-card,.reel-card{ transform:none !important; }
}

/* ===== Create your own beat (additive) ===== */
.beat-cta{
  margin:0 18px 14px; border-radius:999px; background:linear-gradient(90deg,var(--gold),#f0d79b);
  color:#1B1409; text-align:center; padding:14px; font-weight:700; cursor:pointer; font-size:14.5px;
  box-shadow:0 5px 0 #b97a1f; transition:transform .12s ease, box-shadow .12s ease;
}
.beat-cta:active{ transform:translateY(3px); box-shadow:0 2px 0 #b97a1f; }
#beats-page{
  position:fixed; top:0; bottom:0; left:50%; transform:translateX(-50%); width:100%; max-width:430px; z-index:95;
  background:#0b0b0d; display:none; flex-direction:column;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
#beats-page.open{ display:flex; }
#beats-page .bp-bar{ display:flex; align-items:center; gap:10px; padding:10px 14px; border-bottom:1px solid var(--line); background:var(--panel); color:var(--text); }
#beats-page .bp-back{ background:var(--panel-2); border:1px solid var(--line); color:var(--text); border-radius:50%; width:36px; height:36px; font-size:16px; cursor:pointer; }
#beats-page .bp-title{ font-family:'Space Grotesk',system-ui,sans-serif; font-weight:700; font-size:15px; }
#beats-page iframe{ flex:1; width:100%; border:0; background:#0b0b0d; }
</style>
<style id="responsive-layer">
/* ===== Responsive + motion layer (additive) ===== */
.frame{ min-height:100vh; min-height:100dvh; }
.topbar{ padding-top:calc(16px + env(safe-area-inset-top,0px)); }
.bottom-nav{ padding-bottom:env(safe-area-inset-bottom,0px); }
/* app shell: header + bottom nav stay fixed, only the content scrolls */
.frame:has(> .screen > .bottom-nav){ height:100vh; height:100dvh; overflow:hidden; }
.frame > .screen:has(> .bottom-nav){ min-height:0; overflow:hidden; }
.frame > .screen > .content{ min-height:0; -webkit-overflow-scrolling:touch; }
@media (min-width:431px){
  body{ padding:0; }
  .frame{ max-width:640px; min-height:100dvh; border-radius:0; box-shadow:none; }
}

/* ---- laptop / desktop ---- */
@media (min-width:900px){
  .frame{ max-width:none; border:0; }
  .frame::before{ width:540px; height:540px; top:-160px; right:-120px; }
  .frame::after{ width:480px; height:480px; bottom:-180px; left:280px; }
  ::-webkit-scrollbar{ width:8px; height:8px; }
  ::-webkit-scrollbar-thumb{ background:var(--line); border-radius:8px; }
  .frame > .screen:has(> .bottom-nav){
    --cw:860px; display:grid; grid-template-columns:252px minmax(0,1fr); grid-template-rows:auto minmax(0,1fr);
  }
  .frame > .screen:has(> .content > .section-title),
  .frame > .screen:has(> .content > .reel-card){ --cw:1280px; }
  .screen > .topbar{
    grid-column:2; grid-row:1; padding-top:18px; padding-bottom:14px;
    padding-inline:max(24px, calc((100% - var(--cw)) / 2 + 18px));
    background:var(--panel); background:color-mix(in srgb,var(--panel) 78%,transparent); backdrop-filter:blur(14px);
  }
  .screen > .topbar .logo{ font-size:20px; }
  .screen > .content{ grid-column:2; grid-row:2; width:100%; max-width:var(--cw); justify-self:center; padding:6px 0 56px; }
  /* feed / lessons / creation become tile grids */
  .screen:has(> .content > .section-title) > .content,
  .screen:has(> .content > .reel-card) > .content{
    display:grid; grid-template-columns:repeat(auto-fill,minmax(340px,1fr)); gap:16px; align-content:start; grid-auto-rows:max-content; padding:8px 18px 56px;
  }
  .content > .section-title{ grid-column:1 / -1; padding:14px 4px 0; }
  .content > .training-cta, .content > .beat-cta{ margin:6px 0; display:flex; align-items:center; justify-content:center; }
  .screen:has(> .content > .section-title) > .content > :is(.card,.suggest-row,.lesson-card),
  .screen:has(> .content > .reel-card) > .content > .reel-card{
    border:1px solid var(--line); border-radius:20px; background:var(--panel-2); margin:0;
  }
  .screen:has(> .content > .section-title) > .content > :is(.card,.suggest-row,.lesson-card):hover,
  .screen:has(> .content > .reel-card) > .content > .reel-card:hover{ border-color:rgba(232,163,61,.5); }
  /* sidebar nav */
  .screen > .bottom-nav{
    grid-column:1; grid-row:1 / span 2; flex-direction:column; align-items:stretch; justify-content:flex-start; gap:6px;
    position:relative; padding:24px 14px; border-top:0; border-right:1px solid var(--line);
    background:var(--panel); background:color-mix(in srgb,var(--panel) 78%,transparent); backdrop-filter:blur(16px);
  }
  .bottom-nav::before{
    content:"UNDERRATED\A MUSIC"; white-space:pre; display:block; padding:4px 12px 26px;
    font:700 16px/1.1 'Space Grotesk',system-ui,sans-serif; letter-spacing:.16em;
    background:linear-gradient(90deg,var(--gold),#ffcf6e,var(--gold)) 0 0/220% 100%; -webkit-background-clip:text; background-clip:text;
    color:transparent; animation:shine 5s linear infinite;
  }
  .bottom-nav button{
    position:relative; flex:none; flex-direction:row; justify-content:flex-start; gap:14px; padding:13px 16px;
    border-radius:14px; font-size:14.5px; transition:background .2s, color .2s, transform .2s;
  }
  .bottom-nav button .ic{ font-size:20px; width:26px; text-align:center; }
  .bottom-nav button:hover{ background:var(--panel-2); transform:translateX(4px); }
  .bottom-nav button.active{ background:rgba(232,163,61,.13); }
  .bottom-nav button.active::before{
    content:""; position:absolute; left:-14px; top:20%; bottom:20%; width:4px; border-radius:0 4px 4px 0;
    background:var(--gold); box-shadow:0 0 14px var(--gold);
  }
  .bottom-nav::after{
    content:""; margin-top:auto; height:48px; opacity:.8; animation:eq 1.7s ease-in-out infinite alternate;
    background:
      linear-gradient(var(--gold),var(--gold)) 10px 100%/6px 40% no-repeat,
      linear-gradient(var(--violet),var(--violet)) 24px 100%/6px 40% no-repeat,
      linear-gradient(var(--pink),var(--pink)) 38px 100%/6px 40% no-repeat,
      linear-gradient(var(--gold),var(--gold)) 52px 100%/6px 40% no-repeat,
      linear-gradient(var(--green),var(--green)) 66px 100%/6px 40% no-repeat,
      linear-gradient(var(--violet),var(--violet)) 80px 100%/6px 40% no-repeat,
      linear-gradient(var(--pink),var(--pink)) 94px 100%/6px 40% no-repeat,
      linear-gradient(var(--gold),var(--gold)) 108px 100%/6px 40% no-repeat;
  }
  .bubble{ max-width:62%; }
  /* modals centered */
  .deal-overlay{ align-items:center; padding:24px; backdrop-filter:blur(6px); }
  .deal-sheet{ max-width:540px; border-radius:24px; animation:popIn .38s cubic-bezier(.16,1,.3,1); }
  .screen:has(> .deal-sheet){ justify-content:center !important; }
  .screen > .deal-sheet{ align-self:center; margin-top:0 !important; border-radius:24px !important; }
  /* beat lab */
  #beats-page{ max-width:1020px; box-shadow:0 0 0 100vmax rgba(0,0,0,.6); }
  /* onboarding: split hero */
  .onb-hero{ --vs:clamp(220px,26vw,380px); padding:6vh 9vw; }
  .onb-hero > *:not(.vinyl){ width:min(520px,52vw); }
  .onb-title{ font-size:clamp(40px,4.4vw,60px); }
  .onb-sub{ max-width:430px; font-size:17px; }
  .vinyl{ top:50%; right:7vw; width:var(--vs); height:var(--vs); margin-top:calc(var(--vs) / -2); }
  /* other single-column screens (profile form etc.) */
  .frame > .screen:not(.onb-hero):not(:has(> .bottom-nav)):not(:has(> .deal-sheet)){
    width:100%; max-width:620px; margin:0 auto; border-left:1px solid var(--line); border-right:1px solid var(--line);
  }
}

/* ---- animations (only play when a new view opens) ---- */
.view-enter .content > *{ animation:riseIn .6s cubic-bezier(.16,1,.3,1) backwards; animation-delay:calc(var(--i,0) * 55ms); }
