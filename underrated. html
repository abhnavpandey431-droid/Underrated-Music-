/* ---------- toast ---------- */
function toast(msg){
  const el = document.createElement('div');
  el.className = 'toast';
  el.textContent = msg;
  document.body.appendChild(el);
  requestAnimationFrame(()=> el.classList.add('show'));
  setTimeout(()=>{ el.classList.remove('show'); setTimeout(()=> el.remove(), 300); }, 2200);
}

/* ---------- helpers ---------- */
function escapeHtml(str){
  return (str||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function linkifyDeal(text){
  const escaped = escapeHtml(text);
  return escaped.replace(/(50[-_. ]?50|50%)/gi, '<span class="deal-link" data-open-deal="1">$1</span>');
}
function allProfiles(){
  return state.dummies;
}
function oppositeFirstFeed(){
  const mine = state.profile ? state.profile.role : 'writer';
  const opposite = mine === 'writer' ? 'designer' : (mine === 'designer' ? 'writer' : null);
  const list = [...state.dummies];
  list.sort((a,b)=>{
    const aScore = opposite ? (a.role===opposite?0:(a.role==='both'?1:2)) : 0;
    const bScore = opposite ? (b.role===opposite?0:(b.role==='both'?1:2)) : 0;
    return aScore - bScore;
  });
  return list;
}
function findProfileById(id){
  return state.dummies.find(d=>d.id===id) || null;
}
function roleClass(role){
  return role==='designer' ? 'tag-designer' : (role==='both' ? 'tag-both' : 'tag-writer');
}
function roleLabel(role){
  return role==='designer' ? 'Music Designer' : (role==='both' ? 'Writer & Designer' : 'Lyricist / Rapper');
}
function profileEmojiKey(prof){
  const s = (prof.subroleLabel||'').toLowerCase();
  if(prof.role === 'designer'){
    if(s.includes('hip-hop')) return '🥁';
    if(s.includes('song designer')) return '🎹';
    if(s.includes('both')) return '🎛️';
    return '⚡';
  }
  if(s.includes('rapper') && s.includes('singer')) return '🔥';
  if(s.includes('rapper')) return '🎤';
  if(s.includes('singer')) return '🌙';
  return '💫';
}

