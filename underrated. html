@keyframes popIn{ from{ opacity:0; transform:translateY(24px) scale(.96); } }
@keyframes eq{
  0%{ background-size:6px 30%,6px 85%,6px 50%,6px 95%,6px 40%,6px 75%,6px 35%,6px 60%; }
  50%{ background-size:6px 80%,6px 35%,6px 90%,6px 45%,6px 85%,6px 30%,6px 70%,6px 40%; }
  100%{ background-size:6px 45%,6px 70%,6px 30%,6px 80%,6px 60%,6px 95%,6px 55%,6px 85%; }
