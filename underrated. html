function hashIdx(str){
  let h = 0;
  for(let i=0;i<(str||'').length;i++) h = (h*31 + str.charCodeAt(i)) >>> 0;
  return h;
}
function iconGlyph(emojiKey, iconSizePct){
  const iconName = EMOJI_ICON_MAP[emojiKey] || 'wave';
  return `<svg viewBox="0 0 24 24" width="${iconSizePct}" height="${iconSizePct}" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS[iconName]}</svg>`;
}
/* Circular avatar badge: gradient background + line-icon, fully self-contained (no external images) */
function avatarBadge(emojiKey, idx){
  const grad = GRADIENTS[Math.abs(idx||0) % GRADIENTS.length];
  return `<div style="width:100%;height:100%;border-radius:50%;background:${grad};display:flex;align-items:center;justify-content:center;">${iconGlyph(emojiKey,'52%')}</div>`;
